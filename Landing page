<script>
(function () {
  document.getElementById('ano').textContent = new Date().getFullYear();

  // header encolhe ao rolar
  var topo = document.getElementById('topo');
  function onScroll() { topo.classList.toggle('encolhido', window.scrollY > 10); }
  document.addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // uma única entrada orquestrada por seção (não um monte de hover/scroll espalhado)
  var alvos = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('on'); obs.unobserve(e.target); } });
    }, { threshold: .15 });
    alvos.forEach(function (el) { obs.observe(el); });
  } else {
    alvos.forEach(function (el) { el.classList.add('on'); });
  }

  // só um item do FAQ aberto por vez
  document.querySelectorAll('.faq-item').forEach(function (d) {
    d.addEventListener('toggle', function () {
      if (!d.open) return;
      document.querySelectorAll('.faq-item[open]').forEach(function (o) { if (o !== d) o.open = false; });
    });
  });
})();
</script>
