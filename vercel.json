{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/filmes/:slug", "destination": "/filmes/:slug.html" },
    { "source": "/series/:slug", "destination": "/series/:slug.html" },
    { "source": "/Shorts", "destination": "https://reproduvideocurto.canalpedroid.workers.dev/Shorts" },
    { "source": "/Shorts/:path*", "destination": "https://reproduvideocurto.canalpedroid.workers.dev/Shorts/:path*" }
  ],
  "cleanUrls": true
}
